# Local development only. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/cloud_native_ai
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
DATABASE_URL=sqlite:///./cloud_native_ai_backend.db
AUTO_CREATE_DATABASE=true
WORKER_ID=development-worker
WORKER_POLL_INTERVAL_SECONDS=1.0

